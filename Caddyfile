# HTTPS (automatic Let's Encrypt certificates) in front of the app.
# Caddy redirects plain HTTP to HTTPS on its own (308); www goes to the bare domain.
{
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/, fetched
		# 2026-09-26). Only for requests from these addresses does Caddy believe the
		# visitor address in the headers; everyone else is judged by their own
		# connection. That keeps the API's per-visitor rate limit working with or
		# without the Cloudflare proxy, and unspoofable either way.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Caching, for browsers and Cloudflare.
	# Built UI files carry a content hash in their names, so they never change.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Map fonts and icons change only with a new release.
	@basemap path /basemap/*
	header @basemap Cache-Control "public, max-age=604800"
	# Map tiles and outlines are rebuilt at most weekly.
	@daily path /tiles/* /api/boundary /api/region
	header @daily Cache-Control "public, max-age=86400"
	# The page itself is rechecked every time so new releases show up at once.
	@page path / /index.html
	header @page Cache-Control "no-cache"
	# Lookups, routes and health are never cached.
	@dynamic path /api/geocode /api/solve /api/health
	header @dynamic Cache-Control "no-store"

	reverse_proxy api:8000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
