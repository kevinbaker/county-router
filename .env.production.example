# Copy to .env on the server and fill in.

# The bare domain (no www). Caddy gets certificates for it and for www automatically;
# http:// redirects to https:// and www to https://<DOMAIN>. DNS for both names must point
# at the server.
DOMAIN=collincountyrouteplanner.com

# The server user that owns ./logs (the app writes the request log there).
APP_UID=1000
APP_GID=1000

# Change only if 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443

# Optional alerts: check URLs from a monitoring service (e.g. healthchecks.io). Each job
# pings the URL on success and <URL>/fail on failure.
CAD_PING_URL=
OSM_PING_URL=
WATCHDOG_PING_URL=
